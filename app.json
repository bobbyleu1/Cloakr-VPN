{
  "expo": {
    "name": "Cloakr VPN",
    "slug": "cloakr-vpn",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon.png",
    "scheme": "cloakr",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/images/SplashScreen.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vroomstudios.cloakr",
      "buildNumber": "1.0.1",
      "appleTeamId": "Y9LC8G72Z7",
      "infoPlist": {
        "UIBackgroundModes": ["background-fetch", "background-processing"]
      }
    },

    "android": {
      "package": "com.cloakrvpn",
      "versionCode": 3,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "minSdkVersion": 24,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/AppIcon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "WAKE_LOCK",
        "BIND_VPN_SERVICE"
      ]
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-background-fetch",
      "expo-task-manager",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/SplashScreen.png",
          "resizeMode": "cover",
          "backgroundColor": "#000000"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-6842873031676463~1595669539",
          "androidAppId": "ca-app-pub-6842873031676463~6993451975"
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "b5f1cb00-adea-44c8-89ef-6ff3c3cb90b6"
      }
    },

    "experiments": {
      "typedRoutes": true
    }
  }
}
